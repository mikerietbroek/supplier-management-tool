{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supplier-management-tool",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // Aangemaakt met: .\scripts\cf-kv.ps1 init
    { "binding": "SNAPSHOT", "id": "10b5370648334ff6a382800b35f36fae" }
  ],
  "vars": {
    // Uit Worker > Access > Application values
    "ACCESS_TEAM_DOMAIN": "https://old-feather-fcab.cloudflareaccess.com",
    "ACCESS_AUD": "4c288a524b8d7afe06e653af2bb9f8ba738eee988c07271e1099a41a17e4fab4"
  },
  "observability": { "enabled": true }
}
